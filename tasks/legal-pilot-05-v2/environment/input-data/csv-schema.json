    "identifier_mapping": "E1=证据1；C1=反证1；C2-1=反证2-1；C3=反证3",
    "date_policy": "publication_date仅填写决定明确列明的该文献公开/出版日期；精度day:YYYY-MM-DD,month:YYYY-MM,year:YYYY。未知留空，精度not_stated（不适用时not_applicable）。优先权/提交/申请日期另行记录。这36件的首次提交日期在决定p4–7已有记录，first_submitted_on为必填YYYY-MM-DD；程序更正写procedural_status。",
    "date_status_note": "potential_pre_priority表示记载日期早于成立优先权日，但文件的公开可得性未独立核验；treated_as_prior_art表示决定实际按现有技术进行比较；not_assessed表示本决定未单独判断该资格。citation_status记录决定对引证文件问题的处理。争议和附条件复核意见另写相应文字栏。",
    "pages_policy": "decision_pages用物理页数字列表，逗号或分号分隔，例如4;8。全部引用回到实际输入，不填底层译文的175页作为决定页。",
    "required_nonempty_fields": [
      "evidence_id",
      "item_name",
      "presenter",
      "source_role",
      "date_precision",
      "first_submitted_on",
      "prior_art_status",
      "citation_status",
      "decision_pages"
    ],
    "blank_allowed_when_not_stated": [
      "publication_date",
      "procedural_status",
      "authenticity_translation",
      "asserted_purpose",
      "panel_evaluation",
      "underlying_material_gap"
    ],
    "missing_value_policy": "已提供的名称、提出方、来源角色、36件首次提交日期及实际页码需填写；枚举中的not_stated、not_assessed、not_applicable等按其定义填写。未记载的公开日期留空并保留日期精度；未单独转述的叙述事实可留空或说明未记载/未单独评价。决定已明确记载的事实仍应据记录填写。"
  },
