{
  "version": 1,
  "purpose": "财务模型交接索引：按稳定业务名称检索、调整活动输入和复核结果，不依赖页面标签及布局。",
  "named_region_contract": "工作簿级名称，不区分大小写，每个名称直接引用该工作簿现有工作表的一个单元格；不得引用多格区域、外部文件、常量或命名公式。名称可指向任意sheet/cell；业务标签可在数值上方、下方或任意合适位置，措辞自由。",
  "storage_units": "金额统一用所选存值单位；metric_amount_scale为存值转人民币元的正倍率，metric_share_scale为存值转份数的正倍率。两个倍率可省，默认1，即人民币元和份。例如元/万元/百万元的金额倍率分别1/10000/1000000，份/万份/亿份的份数倍率分别1/10000/100000000。每份金额始终元/份、比例始终0至1小数，不缩放。展示格式可另设但须标单位。",
  "optional_scales": [
    {
      "name": "metric_amount_scale",
      "default": 1,
      "meaning": "金额存值转人民币元倍率",
      "valid_range": "有限正数"
    },
    {
      "name": "metric_share_scale",
      "default": 1,
      "meaning": "份额存值转份数倍率",
      "valid_range": "有限正数"
    }
  ],
